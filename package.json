{
  "name": "agentcut",
  "version": "0.3.0",
  "description": "Agent-first video editor: declarative JSON timeline, CLI + MCP server, Skia + FFmpeg renderer.",
  "type": "module",
  "bin": {
    "agentcut": "dist/cli.js",
    "agentcut-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "scripts/bunfig.empty.toml",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun --no-install scripts/build.ts",
    "test": "bun --no-install scripts/test.ts",
    "docs": "bun --no-install -e \"import {GUIDE} from './src/docs.ts'; require('node:fs').writeFileSync('AGENTS.md', GUIDE.trim() + '\\n')\"",
    "ui": "bun --no-install scripts/build-ui.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/ui",
    "prepublishOnly": "bun --no-install scripts/build.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@stylexjs/stylex": "0.19.2",
    "@types/bun": "^1.4.5",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "video",
    "editor",
    "mcp",
    "agent",
    "ffmpeg",
    "skia",
    "capcut"
  ]
}
