{
  "name": "agentcut",
  "version": "0.3.0",
  "description": "Agent-first video editor: declarative JSON timeline, CLI + MCP server, Skia + FFmpeg renderer.",
  "type": "module",
  "bin": {
    "agentcut": "dist/cli.js",
    "agentcut-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "scripts/bunfig.empty.toml",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun --no-install scripts/build.ts",
    "test": "bun --no-install scripts/test.ts",
    "docs": "bun --no-install -e \"import {GUIDE} from './src/docs.ts'; require('node:fs').writeFileSync('AGENTS.md', GUIDE.trim() + '\\n')\"",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "bun --no-install scripts/build.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "video",
    "editor",
    "mcp",
    "agent",
    "ffmpeg",
    "skia",
    "capcut"
  ]
}
